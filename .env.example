# Copy to .env.local and fill in. Never commit the real file.
# After editing, restart `npm run dev` — Next.js reads env files only at startup.

# --- Supabase (Project Settings -> API). URL and both keys from the SAME project.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses Row Level Security — never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- LiveKit (cloud.livekit.io -> your project -> Settings -> Keys)
# Must be the public wss:// URL. A local server (ws://localhost, ws://192.168.x.x)
# only works for devices on your own Wi-Fi — the "calls only work between my
# own devices" bug.
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Web Push, so calls ring when Spark is closed / the phone is locked.
# Generate once with:  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact address push services can reach if your sender misbehaves.
VAPID_SUBJECT=mailto:you@example.com
